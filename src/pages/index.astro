---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMagazine from '../components/HeroMagazine.astro';
import MarketHeatmap from '../components/MarketHeatmap.astro';
import MarketStats from '../components/MarketStats.astro';
import NewsGrid from '../components/NewsGrid.astro';
import ColumnistsSection from '../components/ColumnistsSection.astro';

const trilhas = [
  { num: '01', titulo: 'Fundamentos & Redes', desc: 'Chaves públicas, privadas, blocos, consenso e taxas de rede.' },
  { num: '02', titulo: 'Autocustódia Segura', desc: 'Hot wallets, cold wallets, backup de seed phrase e proteção anti-phishing.' },
  { num: '03', titulo: 'Mecânica DeFi', desc: 'DEXs, pools de liquidez, impermanent loss e stablecoins.' },
  { num: '04', titulo: 'Regras & Impostos', desc: 'IN 1888, cálculo de preço médio e organização de histórico.' },
];
---

<BaseLayout title="Portal de Notícias, Cotações & Educação Cripto">
  <!-- 1. Manchetes Principais em Grid Magazine (Livecoins Style) -->
  <HeroMagazine />

  <!-- 2. Mapa de Calor do Mercado (Coin360 Heatmap) -->
  <MarketHeatmap />

  <!-- 3. Indicadores de Mercado (Fear & Greed + Altas e Baixas) -->
  <MarketStats />

  <!-- 4. Grid Noticioso Completo com Imagens e Tags -->
  <NewsGrid />

  <!-- 5. Seção de Colunistas e Análises Especiais -->
  <ColumnistsSection />

  <!-- 6. Seção de Ferramentas & Trilhas Educacionais -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-14">
    <!-- Coluna Ferramenta Rápida (Calculadora de Preço Médio) -->
    <div class="lg:col-span-5 p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-mono uppercase text-brand-orange font-bold">Utilitário Instantâneo</span>
        <span class="text-[11px] font-mono text-slate-400">100% LOCAL</span>
      </div>

      <h2 class="font-display font-bold text-xl mb-1">Calculadora de Preço Médio (DCA)</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mb-5 leading-relaxed">
        Calcule seu ponto de equilíbrio e custo médio ponderado sem que seus dados saiam do navegador.
      </p>

      <div class="space-y-3.5 text-xs">
        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="block font-mono text-slate-500 mb-1">Qtd. Compra 1</label>
            <input id="q1" type="number" step="any" placeholder="0.5" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 font-mono" />
          </div>
          <div>
            <label class="block font-mono text-slate-500 mb-1">Preço Unit. 1 (R$)</label>
            <input id="p1" type="number" step="any" placeholder="300000" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 font-mono" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="block font-mono text-slate-500 mb-1">Qtd. Compra 2</label>
            <input id="q2" type="number" step="any" placeholder="0.25" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 font-mono" />
          </div>
          <div>
            <label class="block font-mono text-slate-500 mb-1">Preço Unit. 2 (R$)</label>
            <input id="p2" type="number" step="any" placeholder="360000" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 font-mono" />
          </div>
        </div>

        <button
          id="calc-pm"
          type="button"
          class="w-full py-3 rounded-xl bg-brand-cobalt hover:bg-blue-700 text-white font-display font-bold text-sm transition shadow-sm"
        >
          Calcular Preço Médio
        </button>

        <div id="pm-result" class="hidden p-4 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 font-mono text-xs space-y-2">
          <div class="flex justify-between">
            <span class="text-slate-500">Total acumulado:</span>
            <span id="res-qtd" class="font-bold">0</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Preço Médio Ponderado:</span>
            <span id="res-pm" class="font-bold text-brand-cobalt dark:text-brand-cyan">R$ 0,00</span>
          </div>
        </div>

        <div class="pt-2 text-center">
          <a href="/ferramentas/preco-medio" class="text-xs font-mono text-brand-cobalt dark:text-brand-cyan hover:underline">
            Adicionar Mais Ordens na Calculadora Completa →
          </a>
        </div>
      </div>
    </div>

    <!-- Coluna Trilhas Técnicas -->
    <div class="lg:col-span-7 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800">
        <div>
          <span class="text-xs font-mono uppercase text-brand-purple font-bold">Capacitação</span>
          <h2 class="font-display font-bold text-xl text-slate-900 dark:text-slate-100">
            Trilhas de Educação Técnica
          </h2>
        </div>
        <a href="/educacao" class="text-xs font-mono font-bold text-brand-purple hover:underline">
          EXPLORAR GUIAS →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {trilhas.map((t) => (
          <a href="/educacao" class="group p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-brand-purple/50 transition shadow-sm">
            <span class="font-mono text-xs font-bold text-brand-purple">{t.num}.</span>
            <h3 class="font-display font-bold text-base mt-1 mb-1 group-hover:text-brand-cobalt dark:group-hover:text-brand-cyan transition">
              {t.titulo}
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              {t.desc}
            </p>
          </a>
        ))}
      </div>

      <!-- Banner de Destaque DeFi Tools -->
      <div class="p-6 rounded-2xl bg-gradient-to-r from-brand-cobalt/10 via-brand-purple/10 to-transparent border border-brand-cobalt/20 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-[10px] font-mono uppercase text-brand-cobalt dark:text-brand-cyan font-bold">Simulação Matemática</span>
          <h3 class="font-display font-bold text-base">Simulador de Impermanent Loss em Pools 50/50</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Verifique a divergência entre fornecer liquidez e segurar em carteira (HODL).</p>
        </div>
        <a
          href="/ferramentas/impermanent-loss"
          class="shrink-0 px-4 py-2 rounded-xl bg-brand-cobalt hover:bg-blue-700 text-white font-mono text-xs font-bold transition shadow-sm"
        >
          SIMULAR AGORA →
        </a>
      </div>
    </div>
  </section>

  <script>
    document.getElementById('calc-pm')?.addEventListener('click', () => {
      const q1 = parseFloat((document.getElementById('q1') as HTMLInputElement).value) || 0;
      const p1 = parseFloat((document.getElementById('p1') as HTMLInputElement).value) || 0;
      const q2 = parseFloat((document.getElementById('q2') as HTMLInputElement).value) || 0;
      const p2 = parseFloat((document.getElementById('p2') as HTMLInputElement).value) || 0;

      const totalQtd = q1 + q2;
      const resultBox = document.getElementById('pm-result');
      if (totalQtd <= 0 || !resultBox) return;

      const pm = (q1 * p1 + q2 * p2) / totalQtd;
      document.getElementById('res-qtd')!.textContent = totalQtd.toLocaleString('pt-BR', { maximumFractionDigits: 8 });
      document.getElementById('res-pm')!.textContent = pm.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      resultBox.classList.remove('hidden');
    });
  </script>
</BaseLayout>
