---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('noticias');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="max-w-3xl mx-auto">
    <div class="mb-6 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono mb-3">
        <span class="px-2.5 py-1 rounded bg-brand-cobalt/10 text-brand-cobalt dark:bg-brand-cyan/10 dark:text-brand-cyan font-semibold">{post.data.category}</span>
        <span class="text-slate-500">{post.data.pubDate.toLocaleDateString('pt-BR')} • Leitura: {post.data.readingTime}</span>
      </div>
      <h1 class="font-display font-bold text-3xl sm:text-4xl leading-tight mb-3">{post.data.title}</h1>
      <p class="text-base text-slate-600 dark:text-slate-400">{post.data.description}</p>
      {post.data.author && (
        <p class="mt-4 text-xs font-mono text-slate-500 dark:text-slate-400">Autoria editorial: {post.data.author}</p>
      )}
    </div>

    <div class="prose prose-slate dark:prose-invert max-w-none leading-relaxed space-y-4">
      <Content />
    </div>

    {post.data.sources.length > 0 && (
      <section class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-800" aria-labelledby="article-sources-title">
        <h2 id="article-sources-title" class="font-display font-bold text-lg mb-3">Fontes e referências</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-slate-600 dark:text-slate-400">
          {post.data.sources.map((source) => (
            <li><a href={source.url} target="_blank" rel="noopener noreferrer" class="text-brand-cobalt dark:text-brand-cyan hover:underline">{source.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800">
      <a href="/noticias" class="text-sm font-mono text-brand-cobalt dark:text-brand-cyan hover:underline">← Voltar para todas as notícias</a>
    </div>
  </article>
</BaseLayout>
