---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('noticias')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categorias = ['TODAS', 'REGULAÇÃO', 'SEGURANÇA', 'INFRAESTRUTURA', 'MERCADO'];
---

<BaseLayout
  title="Boletim Técnico & Notícias"
  description="Acompanhe novidades sobre regulação, segurança, infraestrutura e mercado cripto com rigor factual."
>
  <div class="max-w-4xl mx-auto space-y-8">
    <div>
      <span class="text-xs font-mono uppercase text-brand-cobalt dark:text-brand-cyan font-semibold">Atualizações Factuais</span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl mt-1 mb-2">Boletim Técnico & Notícias</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Informações selecionadas sobre governança de protocolos, decisões regulatórias e vetores de segurança.
      </p>
    </div>

    <!-- Filtros de Categoria -->
    <div class="flex flex-wrap gap-2 pt-2 border-b border-slate-200 dark:border-slate-800 pb-4">
      {categorias.map((cat, idx) => (
        <button
          type="button"
          data-filter={cat}
          class={`filter-btn px-3 py-1.5 rounded-lg text-xs font-mono transition ${
            idx === 0
              ? 'bg-brand-cobalt text-white dark:bg-brand-cyan dark:text-slate-950 font-bold active'
              : 'bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:border-brand-cobalt dark:hover:border-brand-cyan'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Lista de Artigos -->
    <div id="posts-container" class="space-y-4">
      {posts.map((post) => (
        <article
          data-category={post.data.category}
          class="post-card p-6 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-brand-cobalt/50 dark:hover:border-brand-cyan/50 transition"
        >
          <div class="flex items-center gap-3 text-xs font-mono mb-2">
            <span class="px-2 py-0.5 rounded bg-brand-cobalt/10 text-brand-cobalt dark:bg-brand-cyan/10 dark:text-brand-cyan font-medium">
              {post.data.category}
            </span>
            <span class="text-slate-400">Leitura: {post.data.readingTime}</span>
            <span class="text-slate-400">• {post.data.pubDate.toLocaleDateString('pt-BR')}</span>
          </div>
          <h2 class="font-display font-bold text-xl mb-2">
            <a href={`/noticias/${post.id}`} class="hover:text-brand-cobalt dark:hover:text-brand-cyan transition">
              {post.data.title}
            </a>
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            {post.data.description}
          </p>
          <a href={`/noticias/${post.id}`} class="text-xs font-mono font-medium text-brand-cobalt dark:text-brand-cyan hover:underline">
            LER ARTIGO COMPLETO →
          </a>
        </article>
      ))}
    </div>

    <div id="no-results" class="hidden p-8 text-center text-sm font-mono text-slate-500 border border-dashed border-slate-300 dark:border-slate-800 rounded-xl">
      Nenhum boletim encontrado para esta categoria.
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const posts = document.querySelectorAll('.post-card');
    const noResults = document.getElementById('no-results');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        buttons.forEach((b) => {
          b.classList.remove('bg-brand-cobalt', 'text-white', 'dark:bg-brand-cyan', 'dark:text-slate-950', 'font-bold', 'active');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'border', 'border-slate-200', 'dark:border-slate-800', 'text-slate-600', 'dark:text-slate-400');
        });

        btn.classList.add('bg-brand-cobalt', 'text-white', 'dark:bg-brand-cyan', 'dark:text-slate-950', 'font-bold', 'active');
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');

        let visibleCount = 0;
        posts.forEach((p) => {
          const category = p.getAttribute('data-category');
          if (filter === 'TODAS' || category === filter) {
            (p as HTMLElement).style.display = 'block';
            visibleCount++;
          } else {
            (p as HTMLElement).style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  </script>
</BaseLayout>
