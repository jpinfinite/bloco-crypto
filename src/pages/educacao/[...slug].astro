---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('educacao');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<BaseLayout title={guide.data.title} description={guide.data.description}>
  <article class="max-w-3xl mx-auto">
    <div class="mb-6 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3 text-xs font-mono mb-3">
        <span class="px-2.5 py-1 rounded bg-brand-purple/10 text-brand-purple font-semibold">
          {guide.data.trilha}
        </span>
        <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
          Nível: {guide.data.nivel}
        </span>
        <span class="text-slate-500">
          Leitura: {guide.data.readingTime}
        </span>
      </div>
      <h1 class="font-display font-bold text-3xl sm:text-4xl leading-tight mb-3">
        {guide.data.title}
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-400">
        {guide.data.description}
      </p>
    </div>

    <div class="prose prose-slate dark:prose-invert max-w-none leading-relaxed space-y-4">
      <Content />
    </div>

    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800">
      <a href="/educacao" class="text-sm font-mono text-brand-cobalt dark:text-brand-cyan hover:underline">
        ← Voltar para as Trilhas de Educação
      </a>
    </div>
  </article>
</BaseLayout>
