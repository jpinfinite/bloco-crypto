---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calculadora de Preço Médio (DCA)"
  description="Calcule com precisão o custo médio ponderado de aquisição e histórico de compras de criptoativos."
>
  <div class="max-w-3xl mx-auto space-y-8">
    <div>
      <span class="text-xs font-mono uppercase text-brand-orange font-semibold">Ferramenta • Gestão Patrimonial</span>
      <h1 class="font-display font-bold text-3xl mt-1 mb-2">Calculadora de Preço Médio (DCA)</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Simule compras fracionadas e determine o preço médio exato por unidade sem enviar dados para servidores externos.
      </p>
    </div>

    <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-6">
      <div id="orders-container" class="space-y-3">
        <!-- Linhas de Ordens Dinâmicas -->
      </div>

      <div class="flex flex-wrap gap-3">
        <button
          id="btn-add-order"
          type="button"
          class="px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-mono transition"
        >
          + Adicionar Ordem
        </button>
        <button
          id="btn-calc"
          type="button"
          class="px-6 py-2 rounded-lg bg-brand-cobalt hover:bg-blue-700 text-white font-display font-bold text-xs transition"
        >
          Calcular Média
        </button>
      </div>

      <!-- Resumo Ponderado -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-200 dark:border-slate-800 font-mono">
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
          <span class="text-xs text-slate-500 block mb-1">Total de Unidades</span>
          <span id="out-total-qtd" class="text-lg font-bold">0</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
          <span class="text-xs text-slate-500 block mb-1">Total Aporte (R$)</span>
          <span id="out-total-cost" class="text-lg font-bold">R$ 0,00</span>
        </div>

        <div class="p-4 rounded-xl bg-brand-cobalt/10 dark:bg-brand-cyan/10 border border-brand-cobalt/30 dark:border-brand-cyan/30">
          <span class="text-xs text-brand-cobalt dark:text-brand-cyan block mb-1">Preço Médio Unitário</span>
          <span id="out-avg-price" class="text-lg font-bold text-brand-cobalt dark:text-brand-cyan">R$ 0,00</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    interface Order {
      qtd: number;
      price: number;
    }

    const container = document.getElementById('orders-container')!;
    let orderCount = 0;

    function addRow(defaultQtd = '', defaultPrice = '') {
      orderCount++;
      const row = document.createElement('div');
      row.className = 'grid grid-cols-12 gap-2 items-center text-xs order-row';
      row.id = `order-${orderCount}`;
      row.innerHTML = `
        <div class="col-span-1 font-mono text-slate-400">#${orderCount}</div>
        <div class="col-span-5">
          <input type="number" step="any" placeholder="Quantidade" value="${defaultQtd}" class="order-qtd w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 font-mono" />
        </div>
        <div class="col-span-5">
          <input type="number" step="any" placeholder="Preço Unit. (R$)" value="${defaultPrice}" class="order-price w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 font-mono" />
        </div>
        <div class="col-span-1 text-right">
          <button type="button" class="btn-remove text-rose-500 hover:text-rose-700 font-mono text-base px-2">×</button>
        </div>
      `;

      row.querySelector('.btn-remove')?.addEventListener('click', () => {
        row.remove();
        calcPM();
      });

      row.querySelectorAll('input').forEach(input => {
        input.addEventListener('input', calcPM);
      });

      container.appendChild(row);
    }

    function calcPM() {
      const rows = document.querySelectorAll('.order-row');
      let totalQtd = 0;
      let totalCost = 0;

      rows.forEach(r => {
        const qtd = parseFloat((r.querySelector('.order-qtd') as HTMLInputElement).value) || 0;
        const price = parseFloat((r.querySelector('.order-price') as HTMLInputElement).value) || 0;
        if (qtd > 0 && price > 0) {
          totalQtd += qtd;
          totalCost += qtd * price;
        }
      });

      const avg = totalQtd > 0 ? totalCost / totalQtd : 0;

      document.getElementById('out-total-qtd')!.textContent = totalQtd.toLocaleString('pt-BR', { maximumFractionDigits: 8 });
      document.getElementById('out-total-cost')!.textContent = totalCost.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      document.getElementById('out-avg-price')!.textContent = avg.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    document.getElementById('btn-add-order')?.addEventListener('click', () => addRow());
    document.getElementById('btn-calc')?.addEventListener('click', calcPM);

    // Initial 2 rows
    addRow('0.5', '300000');
    addRow('0.25', '360000');
    calcPM();
  </script>
</BaseLayout>
