---
const coins = [
  { id: 'btc', key: 'bitcoin', label: 'BTC', name: 'Bitcoin', color: 'from-slate-600 to-slate-700', span: 'col-span-12 sm:col-span-6' },
  { id: 'eth', key: 'ethereum', label: 'ETH', name: 'Ethereum', color: 'from-slate-600 to-slate-700', span: 'col-span-7 sm:col-span-3' },
  { id: 'sol', key: 'solana', label: 'SOL', name: 'Solana', color: 'from-slate-600 to-slate-700', span: '' },
  { id: 'bnb', key: 'binancecoin', label: 'BNB', name: 'BNB', color: 'from-slate-600 to-slate-700', span: '' },
  { id: 'xrp', key: 'ripple', label: 'XRP', name: 'XRP', color: 'from-slate-600 to-slate-700', span: '' },
  { id: 'doge', key: 'dogecoin', label: 'DOGE', name: 'Dogecoin', color: 'from-slate-600 to-slate-700', span: '' },
];
---

<section class="mb-10">
  <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2.5">
      <div class="w-3 h-3 rounded bg-slate-400"></div>
      <h2 class="font-display font-bold text-lg text-slate-900 dark:text-slate-100">Mapa de Calor do Mercado (24h)</h2>
    </div>
    <span id="heatmap-updated" class="text-xs font-mono text-slate-500">AGUARDANDO DADOS • COINGECKO</span>
  </div>

  <div class="grid grid-cols-12 gap-2 h-72 sm:h-80 font-mono text-white select-none">
    <div id="hm-btc" class="col-span-12 sm:col-span-6 bg-slate-600 rounded-xl p-4 flex flex-col justify-between shadow-sm transition">
      <div class="flex justify-between items-start">
        <div><span class="text-xs font-bold text-slate-200">01</span><h3 class="font-display font-extrabold text-2xl sm:text-3xl">BTC</h3><span class="text-xs text-slate-200">Bitcoin</span></div>
        <span id="hm-btc-change" class="px-2 py-0.5 rounded bg-black/30 text-xs font-bold">—</span>
      </div>
      <div class="flex justify-between items-end"><span class="text-xs text-slate-200/80">Variação 24h</span><span id="hm-btc-price" class="text-lg sm:text-xl font-bold">—</span></div>
    </div>
    <div id="hm-eth" class="col-span-7 sm:col-span-3 bg-slate-600 rounded-xl p-3.5 flex flex-col justify-between shadow-sm transition">
      <div class="flex justify-between items-start"><div><span class="text-[10px] font-bold text-slate-200">02</span><h3 class="font-display font-bold text-xl">ETH</h3><span class="text-[11px] text-slate-200">Ethereum</span></div><span id="hm-eth-change" class="px-1.5 py-0.5 rounded bg-black/30 text-[11px] font-bold">—</span></div>
      <div><span id="hm-eth-price" class="text-sm sm:text-base font-bold block">—</span><span class="text-[10px] text-slate-200/80">Variação 24h</span></div>
    </div>
    <div class="col-span-5 sm:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
      {coins.slice(2).map((coin) => (
        <div id={`hm-${coin.id}`} class="bg-slate-600 rounded-xl p-3 flex flex-col justify-between transition">
          <div class="flex justify-between items-center"><span class="font-bold text-sm">{coin.label}</span><span id={`hm-${coin.id}-change`} class="text-[10px] font-bold bg-black/30 px-1 rounded">—</span></div>
          <span id={`hm-${coin.id}-price`} class="text-xs font-bold">—</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const formatPrice = (value: number) => value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: value < 1 ? 4 : 2 });
  const keys: Record<string, string> = { btc: 'bitcoin', eth: 'ethereum', sol: 'solana', bnb: 'binancecoin', xrp: 'ripple', doge: 'dogecoin' };

  fetch('/api/market')
    .then((response) => response.ok ? response.json() : null)
    .then((data) => {
      if (!data?.prices) return;
      for (const [short, key] of Object.entries(keys)) {
        const coin = data.prices[key];
        if (!coin) continue;
        const price = document.getElementById(`hm-${short}-price`);
        const change = document.getElementById(`hm-${short}-change`);
        const card = document.getElementById(`hm-${short}`);
        if (price && Number.isFinite(coin.brl)) price.textContent = formatPrice(coin.brl);
        if (change && Number.isFinite(coin.brl_24h_change)) {
          const up = coin.brl_24h_change >= 0;
          change.textContent = `${up ? '+' : ''}${coin.brl_24h_change.toFixed(2)}%`;
          change.className = `px-2 py-0.5 rounded bg-black/30 text-xs font-bold ${up ? 'text-emerald-200' : 'text-rose-200'}`;
          if (card) card.className = `${card.className.replace(/bg-(slate|emerald|rose)-\d+/g, '')} ${up ? 'bg-emerald-700' : 'bg-rose-800'} rounded-xl`;
        }
      }
      const updated = document.getElementById('heatmap-updated');
      if (updated && data.updatedAt) updated.textContent = `ATUALIZADO ${new Date(data.updatedAt).toLocaleTimeString('pt-BR')}`;
    })
    .catch(() => {});
</script>
