---
// Mapa de Calor do Mercado Cripto (Visual Coin360 / Treemap)
---

<section class="mb-10">
  <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2.5">
      <div class="w-3 h-3 rounded bg-emerald-500"></div>
      <h2 class="font-display font-bold text-lg text-slate-900 dark:text-slate-100">
        Mapa de Calor do Mercado (Top Cap 24h)
      </h2>
    </div>
    <span class="text-xs font-mono text-slate-500">ATUALIZADO A CADA 5 MIN</span>
  </div>

  <div class="grid grid-cols-12 gap-2 h-72 sm:h-80 font-mono text-white select-none">
    <!-- BTC (Dominância Principal ~50% da área) -->
    <div class="col-span-12 sm:col-span-6 bg-gradient-to-br from-emerald-600 to-emerald-700 rounded-xl p-4 flex flex-col justify-between shadow-sm hover:brightness-105 transition cursor-pointer">
      <div class="flex justify-between items-start">
        <div>
          <span class="text-xs font-bold text-emerald-100 tracking-wider">01</span>
          <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-white">BTC</h3>
          <span class="text-xs text-emerald-100">Bitcoin</span>
        </div>
        <span class="px-2 py-0.5 rounded bg-black/30 text-xs font-bold text-emerald-200">
          +2.84%
        </span>
      </div>
      <div class="flex justify-between items-end">
        <span class="text-xs text-emerald-100/80">Dom: 58.4%</span>
        <span class="text-lg sm:text-xl font-bold">R$ 548.210</span>
      </div>
    </div>

    <!-- ETH (~25% da área) -->
    <div class="col-span-7 sm:col-span-3 bg-gradient-to-br from-emerald-700 to-emerald-800 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:brightness-105 transition cursor-pointer">
      <div class="flex justify-between items-start">
        <div>
          <span class="text-[10px] font-bold text-emerald-200">02</span>
          <h3 class="font-display font-bold text-xl text-white">ETH</h3>
          <span class="text-[11px] text-emerald-200">Ethereum</span>
        </div>
        <span class="px-1.5 py-0.5 rounded bg-black/30 text-[11px] font-bold text-emerald-200">
          +1.42%
        </span>
      </div>
      <div>
        <span class="text-sm sm:text-base font-bold block">R$ 18.940</span>
        <span class="text-[10px] text-emerald-200/80">Dom: 13.8%</span>
      </div>
    </div>

    <!-- Coluna com Alts (SOL, BNB, XRP, ADA) -->
    <div class="col-span-5 sm:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
      <!-- SOL -->
      <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl p-3 flex flex-col justify-between hover:brightness-105 transition cursor-pointer">
        <div class="flex justify-between items-center">
          <span class="font-bold text-sm">SOL</span>
          <span class="text-[10px] font-bold bg-black/30 px-1 rounded text-emerald-200">+5.6%</span>
        </div>
        <span class="text-xs font-bold">R$ 1.180</span>
      </div>

      <!-- BNB -->
      <div class="bg-gradient-to-br from-rose-700 to-rose-800 rounded-xl p-3 flex flex-col justify-between hover:brightness-105 transition cursor-pointer">
        <div class="flex justify-between items-center">
          <span class="font-bold text-sm">BNB</span>
          <span class="text-[10px] font-bold bg-black/30 px-1 rounded text-rose-200">-0.38%</span>
        </div>
        <span class="text-xs font-bold">R$ 3.820</span>
      </div>

      <!-- XRP -->
      <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl p-3 flex flex-col justify-between hover:brightness-105 transition cursor-pointer">
        <div class="flex justify-between items-center">
          <span class="font-bold text-sm">XRP</span>
          <span class="text-[10px] font-bold bg-black/30 px-1 rounded text-emerald-200">+8.1%</span>
        </div>
        <span class="text-xs font-bold">R$ 8,42</span>
      </div>

      <!-- DOGE -->
      <div class="bg-gradient-to-br from-rose-700 to-rose-900 rounded-xl p-3 flex flex-col justify-between hover:brightness-105 transition cursor-pointer">
        <div class="flex justify-between items-center">
          <span class="font-bold text-sm">DOGE</span>
          <span class="text-[10px] font-bold bg-black/30 px-1 rounded text-rose-200">-1.1%</span>
        </div>
        <span class="text-xs font-bold">R$ 1,24</span>
      </div>
    </div>
  </div>
</section>
