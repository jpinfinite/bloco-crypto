---
// Seção Especial de Análises com Assinatura Editorial Autêntica (E-E-A-T)
const analises = [
  {
    nucleo: 'Redação Regulatória',
    autor: 'Núcleo Jurídico BLOCO\\CRYPTO',
    titulo: 'A responsabilidade civil dos operadores de contratos inteligentes após as decisões do STJ',
    badge: 'LEGISLAÇÃO & PSAV',
    slug: '/noticias/analise-responsabilidade-civil-smart-contracts',
  },
  {
    nucleo: 'Laboratório de Redes',
    autor: 'Engenharia de Protocolos',
    titulo: 'Por que o custo de liquidação de rollups ainda não atingiu seu piso teórico pós-blobs',
    badge: 'ARQUITETURA L2',
    slug: '/noticias/analise-custo-liquidacao-rollups',
  },
  {
    nucleo: 'Auditoria On-Chain',
    autor: 'Pesquisa de Segurança',
    titulo: 'O cemitério de protocolos: lições de 5 anos auditando pontes entre cadeias heterogêneas',
    badge: 'SEGURANÇA DEFENSIVA',
    slug: '/noticias/analise-auditoria-pontes-cross-chain',
  },
  {
    nucleo: 'Pesquisa Quantitativa',
    autor: 'Mesa de Análise DeFi',
    titulo: 'A anatomia do MEV privado e seu impacto invisível na execução de swaps em DEXs',
    badge: 'MECÂNICA DE LIQUIDEZ',
    slug: '/noticias/analise-mev-privado-dexs',
  },
];
---

<section class="mb-14 p-6 sm:p-8 rounded-3xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
  <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-200 dark:border-slate-800">
    <div>
      <span class="text-xs font-mono uppercase text-brand-orange font-bold">Corpo Editorial & Pesquisa</span>
      <h2 class="font-display font-bold text-2xl text-slate-900 dark:text-slate-100">
        Análises Técnicas Aprofundadas
      </h2>
    </div>
    <span class="text-xs font-mono text-slate-500 hidden sm:inline">CRITÉRIO E-E-A-T • ZERO VIÉS</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {analises.map((a) => (
      <a href={a.slug} class="group p-5 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-brand-orange/50 transition shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-brand-dark border border-slate-800 flex items-center justify-center font-brand font-bold text-xs text-white shrink-0">
              B\C
            </div>
            <div>
              <h3 class="font-display font-bold text-sm text-slate-900 dark:text-slate-100 leading-tight">
                {a.autor}
              </h3>
              <span class="text-[11px] font-mono text-slate-500 block leading-tight mt-0.5">
                {a.nucleo}
              </span>
            </div>
          </div>

          <span class="px-2 py-0.5 rounded bg-brand-orange/10 text-brand-orange font-mono text-[10px] font-bold uppercase inline-block mb-2">
            {a.badge}
          </span>

          <h4 class="font-display font-bold text-sm text-slate-800 dark:text-slate-200 group-hover:text-brand-orange transition leading-snug">
            "{a.titulo}"
          </h4>
        </div>

        <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-900 flex justify-end">
          <span class="text-xs font-mono text-brand-orange font-bold">LER ANÁLISE COMPLETA →</span>
        </div>
      </a>
    ))}
  </div>
</section>
