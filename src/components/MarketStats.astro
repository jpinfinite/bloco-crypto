---
const assets = [
  ['bitcoin', 'BTC', 'Bitcoin'],
  ['ethereum', 'ETH', 'Ethereum'],
  ['solana', 'SOL', 'Solana'],
  ['binancecoin', 'BNB', 'BNB'],
  ['ripple', 'XRP', 'XRP'],
  ['dogecoin', 'DOGE', 'Dogecoin'],
  ['tether', 'USDT', 'Tether'],
  ['avalanche-2', 'AVAX', 'Avalanche'],
  ['cardano', 'ADA', 'Cardano'],
];
---

<section class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-12">
  <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase text-slate-500 font-semibold">Sentimento de Mercado</span>
        <span id="fng-status" class="text-[10px] font-mono text-slate-400">AGUARDANDO API</span>
      </div>
      <h3 class="font-display font-bold text-base mb-2">Índice Medo & Ganância</h3>
      <div class="my-4 flex items-center gap-4">
        <div id="fng-score" class="relative w-20 h-20 rounded-full border-4 border-slate-300 dark:border-slate-700 flex items-center justify-center font-display font-extrabold text-2xl text-slate-500">—</div>
        <div>
          <span id="fng-label" class="text-xs font-mono uppercase text-slate-500 font-bold block">Sem dados</span>
          <span class="text-xs text-slate-500 dark:text-slate-400">Fonte: Alternative.me</span>
        </div>
      </div>
    </div>
    <div id="market-updated" class="pt-3 border-t border-slate-100 dark:border-slate-800 text-[11px] font-mono text-slate-400">Atualização indisponível</div>
  </div>

  <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-mono uppercase text-emerald-600 dark:text-emerald-400 font-semibold">Desempenho Diário</span>
      <span class="text-xs font-mono text-slate-400">24H</span>
    </div>
    <h3 class="font-display font-bold text-base mb-3">Maiores Altas</h3>
    <div id="market-gainers" class="space-y-3 font-mono text-xs" aria-live="polite">
      <p class="text-slate-400">Aguardando dados de mercado…</p>
    </div>
  </div>

  <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-mono uppercase text-rose-500 font-semibold">Desempenho Diário</span>
      <span class="text-xs font-mono text-slate-400">24H</span>
    </div>
    <h3 class="font-display font-bold text-base mb-3">Maiores Baixas</h3>
    <div id="market-losers" class="space-y-3 font-mono text-xs" aria-live="polite">
      <p class="text-slate-400">Aguardando dados de mercado…</p>
    </div>
  </div>
</section>

<script>
  const assetNames: Record<string, { ticker: string; name: string }> = {
    bitcoin: { ticker: 'BTC', name: 'Bitcoin' },
    ethereum: { ticker: 'ETH', name: 'Ethereum' },
    solana: { ticker: 'SOL', name: 'Solana' },
    binancecoin: { ticker: 'BNB', name: 'BNB' },
    ripple: { ticker: 'XRP', name: 'XRP' },
    dogecoin: { ticker: 'DOGE', name: 'Dogecoin' },
    tether: { ticker: 'USDT', name: 'Tether' },
    'avalanche-2': { ticker: 'AVAX', name: 'Avalanche' },
    cardano: { ticker: 'ADA', name: 'Cardano' },
  };

  const money = (value: number) => value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: value < 1 ? 4 : 2 });

  function renderMovers(targetId: string, entries: Array<{ id: string; change: number; price: number }>, positive: boolean) {
    const target = document.getElementById(targetId);
    if (!target) return;
    target.replaceChildren();

    if (!entries.length) {
      const empty = document.createElement('p');
      empty.className = 'text-slate-400';
      empty.textContent = 'Dados indisponíveis no momento.';
      target.append(empty);
      return;
    }

    for (const entry of entries) {
      const asset = assetNames[entry.id];
      if (!asset) continue;
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-slate-950/60 border border-slate-100 dark:border-slate-800/60';
      const identity = document.createElement('div');
      const ticker = document.createElement('span');
      ticker.className = 'font-bold text-slate-800 dark:text-slate-200';
      ticker.textContent = asset.ticker;
      const name = document.createElement('span');
      name.className = 'text-slate-400 text-[11px] ml-1';
      name.textContent = asset.name;
      identity.append(ticker, name);

      const values = document.createElement('div');
      values.className = 'text-right';
      const price = document.createElement('span');
      price.className = 'block font-semibold text-slate-700 dark:text-slate-300';
      price.textContent = money(entry.price);
      const change = document.createElement('span');
      change.className = `font-bold text-[11px] ${positive ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-500'}`;
      change.textContent = `${entry.change > 0 ? '+' : ''}${entry.change.toFixed(2)}%`;
      values.append(price, change);
      row.append(identity, values);
      target.append(row);
    }
  }

  fetch('/api/market')
    .then((response) => response.ok ? response.json() : null)
    .then((data) => {
      const score = document.getElementById('fng-score');
      const label = document.getElementById('fng-label');
      const status = document.getElementById('fng-status');
      const updated = document.getElementById('market-updated');

      if (data?.fearAndGreed && score && label) {
        score.textContent = String(data.fearAndGreed.value);
        label.textContent = data.fearAndGreed.label;
        score.className = 'relative w-20 h-20 rounded-full border-4 border-emerald-500 flex items-center justify-center font-display font-extrabold text-2xl text-emerald-600 dark:text-emerald-400';
      }
      if (status) status.textContent = data?.sources ? 'FONTE CONECTADA' : 'PARCIAL / INDISPONÍVEL';
      if (updated && data?.updatedAt) {
        updated.textContent = `Atualizado: ${new Date(data.updatedAt).toLocaleString('pt-BR')}`;
      }

      const entries = Object.entries(data?.prices || {})
        .filter(([, value]) => Number.isFinite(value?.brl) && Number.isFinite(value?.brl_24h_change))
        .map(([id, value]) => ({ id, price: value.brl, change: value.brl_24h_change }))
        .filter((entry) => entry.id !== 'tether');

      const sorted = [...entries].sort((a, b) => b.change - a.change);
      renderMovers('market-gainers', sorted.slice(0, 3), true);
      renderMovers('market-losers', sorted.slice(-3).reverse(), false);
    })
    .catch(() => {
      renderMovers('market-gainers', [], true);
      renderMovers('market-losers', [], false);
    });
</script>
