---
// Ticker horizontal com cotações em tempo real e variações 24h
const tickers = [
  { id: 'bitcoin', symbol: 'BTC', name: 'Bitcoin', price: 'R$ 548.210', change: '+2.84%', up: true },
  { id: 'ethereum', symbol: 'ETH', name: 'Ethereum', price: 'R$ 18.940', change: '+1.42%', up: true },
  { id: 'solana', symbol: 'SOL', name: 'Solana', price: 'R$ 1.180', change: '+5.61%', up: true },
  { id: 'binancecoin', symbol: 'BNB', name: 'BNB', price: 'R$ 3.820', change: '-0.38%', up: false },
  { id: 'ripple', symbol: 'XRP', name: 'XRP', price: 'R$ 8,42', change: '+8.15%', up: true },
  { id: 'dogecoin', symbol: 'DOGE', name: 'Dogecoin', price: 'R$ 1,24', change: '-1.12%', up: false },
  { id: 'tether', symbol: 'USDT', name: 'Tether USD', price: 'R$ 5,82', change: '+0.05%', up: true },
];
---

<div class="border-b border-slate-200 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-950/70 overflow-x-auto no-scrollbar py-2 px-4 text-xs font-mono">
  <div class="max-w-7xl mx-auto flex items-center gap-6 min-w-max">
    <div class="flex items-center gap-2 pr-4 border-r border-slate-200 dark:border-slate-800 text-[11px] text-slate-500 font-bold tracking-wider uppercase">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
      MERCADO AO VIVO
    </div>

    {tickers.map((t) => (
      <div data-ticker-id={t.id} class="flex items-center gap-2">
        <span class="font-bold text-slate-800 dark:text-slate-200">{t.symbol}</span>
        <span class="coin-price text-slate-600 dark:text-slate-400">{t.price}</span>
        <span class={`coin-change font-semibold text-[11px] ${t.up ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}`}>
          {t.change}
        </span>
      </div>
    ))}

    <div id="live-dynamic-ticker" class="hidden sm:flex items-center gap-2 pl-4 border-l border-slate-200 dark:border-slate-800 text-[11px] text-slate-500">
      <!-- Injetado dinamicamente via /api/network-status -->
    </div>
  </div>
</div>

<script>
  fetch('/api/market')
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      if (!data || !data.prices) return;
      const prices = data.prices;

      document.querySelectorAll('[data-ticker-id]').forEach((el) => {
        const id = el.getAttribute('data-ticker-id');
        if (id && prices[id]) {
          const brl = prices[id].brl;
          const change = prices[id].brl_24h_change;

          if (brl !== undefined) {
            const priceEl = el.querySelector('.coin-price');
            if (priceEl) {
              priceEl.textContent = brl.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            }
          }

          if (change !== undefined) {
            const changeEl = el.querySelector('.coin-change');
            if (changeEl) {
              const isUp = change >= 0;
              changeEl.textContent = `${isUp ? '+' : ''}${change.toFixed(2)}%`;
              changeEl.className = `coin-change font-semibold text-[11px] ${
                isUp ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'
              }`;
            }
          }
        }
      });
    })
    .catch(() => {});
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
